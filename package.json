{
  "name": "jbrancher",
  "version": "0.1.0",
  "description": "Rules-first decision routing for AI agent harnesses, with optional Jev evaluation and actor fallback.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "jbrancher",
    "jev",
    "ai-agents",
    "agent-harness"
  ],
  "repository": "github:henstarr/JBrancher",
  "bugs": "https://github.com/henstarr/JBrancher/issues",
  "homepage": "https://github.com/henstarr/JBrancher#readme",
  "bin": {
    "jbrancher": "./bin/jbrancher.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "demo": "node bin/jbrancher.js demo",
    "doctor": "node bin/jbrancher.js doctor",
    "live:smoke": "node bin/jbrancher.js live-check",
    "bench:offline": "node benchmarks/run-routing.js",
    "bench:cost": "node benchmarks/run-cost.js",
    "bench:tokens": "node benchmarks/run-token-optimization.js",
    "bench:learning": "node benchmarks/run-learning.js",
    "bench:discovery": "node benchmarks/run-discovery.js",
    "bench:live-learning": "node benchmarks/run-live-learning.js",
    "bench:live-codex": "node benchmarks/run-live-codex-learning.js",
    "bench:live-pi-learning": "node benchmarks/run-live-pi-learning.js",
    "bench:swebench": "node benchmarks/run-official-swebench.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./context": "./src/context.js",
    "./jev": "./src/jev.js",
    "./learning": "./src/learning.js",
    "./replay": "./src/replay.js",
    "./discovery": "./src/discovery.js",
    "./pi": "./src/pi.js",
    "./server": "./src/server.js"
  },
  "pi": {
    "extensions": [
      "./extensions/jbrancher.js"
    ]
  },
  "files": [
    "src",
    "bin",
    "extensions",
    "examples",
    "benchmarks",
    "docs",
    "README.md",
    ".env.example",
    "LICENSE"
  ]
}
